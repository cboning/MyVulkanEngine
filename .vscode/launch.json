{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/main.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "logging": {
                "moduleLoad": false,
                "engineLogging": false,
                "exceptions": false
            },
            "MIMode": "gdb",
            "miDebuggerPath": "gdb.exe",
            "preLaunchTask": "CMake: Build with Shaders",
            "setupCommands": [
                {
                    "description": "Enable break on C++ throw",
                    "text": "catch throw",
                    "ignoreFailures": true
                },
                {
                    "description": "Enable break on C++ catch",
                    "text": "catch catch",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "Debug (Shaders Only)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/main.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "logging": {
                "moduleLoad": false,
                "engineLogging": false,
                "exceptions": false
            },
            "MIMode": "gdb",
            "miDebuggerPath": "gdb.exe",
            "preLaunchTask": "compile_shaders",
            "setupCommands": [
                {
                    "description": "Enable break on C++ throw",
                    "text": "catch throw",
                    "ignoreFailures": true
                },
                {
                    "description": "Enable break on C++ catch",
                    "text": "catch catch",
                    "ignoreFailures": true
